{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "kpis",
      "queryLines": [
        "WITH latest AS (SELECT max_by(run_id, ran_at) AS run_id FROM workspace.program_ops.test_results),\n",
        "resolved AS (SELECT case_id, min(event_time) AS resolved_at FROM workspace.program_ops.audit_log WHERE event_type = 'CASE_RESOLVED' GROUP BY case_id)\n",
        "SELECT\n",
        "  (SELECT count_if(passed) FROM workspace.program_ops.test_results WHERE run_id = (SELECT run_id FROM latest)) AS tests_passed,\n",
        "  (SELECT count(*) FROM workspace.program_ops.test_results WHERE run_id = (SELECT run_id FROM latest)) AS tests_total,\n",
        "  (SELECT count(*) - count(DISTINCT idempotency_key) FROM workspace.program_ops.provider_deliveries) AS duplicate_deliveries,\n",
        "  (SELECT count(*) FROM workspace.program_ops.outbox_log o LEFT JOIN resolved r USING (case_id)\n",
        "     WHERE o.email_type = 'DECISION' AND (r.resolved_at IS NULL OR o.created_at < r.resolved_at)) AS early_status_sends,\n",
        "  (SELECT count(*) FROM workspace.program_ops.outbox_attempts WHERE outcome = 'STOPPED_DUPLICATE') AS stopped_duplicates,\n",
        "  (SELECT count(*) FROM workspace.program_ops.outbox_attempts WHERE outcome = 'BLOCKED_BY_GATE') AS blocked_by_gate\n"
      ]
    },
    {
      "name": "ds_timeline",
      "displayName": "timeline",
      "queryLines": [
        "SELECT step, date_format(event_time, 'yyyy-MM-dd HH:mm') AS event_time, event_type, actor, actor_type, headline, details\n",
        "FROM workspace.program_ops.case_timeline WHERE startup_id = 'STU-0427' AND run_context = 'STORY' ORDER BY step\n"
      ]
    },
    {
      "name": "ds_tests",
      "displayName": "tests",
      "queryLines": [
        "SELECT test_no, test_name, CASE WHEN passed THEN 'PASS' ELSE 'FAIL' END AS result, assertions, ran_at\n",
        "FROM workspace.program_ops.test_results WHERE run_id = (SELECT max_by(run_id, ran_at) FROM workspace.program_ops.test_results) ORDER BY test_no\n"
      ]
    },
    {
      "name": "ds_attempts",
      "displayName": "attempts",
      "queryLines": [
        "SELECT a.attempt_id, date_format(a.attempted_at, 'yyyy-MM-dd HH:mm') AS attempted_at, c.run_context, c.startup_id, a.case_id,\n",
        "       a.email_type, a.attempt_label, a.outcome, a.detail, o.state AS outbox_state, o.provider_message_id\n",
        "FROM workspace.program_ops.outbox_attempts a LEFT JOIN workspace.program_ops.cases c USING (case_id)\n",
        "LEFT JOIN workspace.program_ops.outbox_log o ON o.idempotency_key = a.idempotency_key\n",
        "ORDER BY a.attempt_id\n"
      ]
    },
    {
      "name": "ds_records",
      "displayName": "records",
      "queryLines": [
        "SELECT startup_id, startup_name, tracker_status, coalesce(tracker_stage, '(blank)') AS tracker_stage,\n",
        "       date_format(tracker_updated_at, 'yyyy-MM-dd HH:mm') AS tracker_updated_at, tracker_updated_by, tracker_edit_kind,\n",
        "       queue_status, date_format(queue_updated_at, 'yyyy-MM-dd HH:mm') AS queue_updated_at, queue_updated_by, queue_edit_kind\n",
        "FROM workspace.program_ops.case_records_side_by_side ORDER BY startup_id\n"
      ]
    },
    {
      "name": "ds_cases",
      "displayName": "cases",
      "queryLines": [
        "SELECT case_id, run_context, startup_id, case_state, reconciliation, final_status, resolved_by, escalated_to,\n",
        "       needs_human_reason, suggested_reading\n",
        "FROM workspace.program_ops.cases ORDER BY run_context, opened_at\n"
      ]
    }
  ],
